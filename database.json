const sqlite3 = require('sqlite3').verbose();
const path = require('path');
const fs = require('fs');

const dataDir = path.join(__dirname, 'data');
if (!fs.existsSync(dataDir)) {
  fs.mkdirSync(dataDir);
}

const dbPath = path.join(dataDir, 'draw.db');
const db = new sqlite3.Database(dbPath);

db.run('PRAGMA foreign_keys = ON');

// ============================================================
// 初始化所有表
// ============================================================
db.serialize(() => {
  // 用户表
  db.run(`
    CREATE TABLE IF NOT EXISTS users (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      username TEXT UNIQUE NOT NULL,
      password TEXT NOT NULL,
      role TEXT DEFAULT 'user',
      created_at TEXT DEFAULT (datetime('now'))
    )
  `);

  // 操作日志表
  db.run(`
    CREATE TABLE IF NOT EXISTS operation_logs (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      username TEXT NOT NULL,
      action TEXT NOT NULL,
      details TEXT,
      ip TEXT,
      created_at TEXT DEFAULT (datetime('now'))
    )
  `);

  // 资源表
  db.run(`
    CREATE TABLE IF NOT EXISTS resources (
      id TEXT PRIMARY KEY,
      name TEXT NOT NULL,
      type TEXT NOT NULL,
      type_label TEXT NOT NULL,
      responsible TEXT NOT NULL,
      area TEXT
    )
  `);

  // 抽取记录表
  db.run(`
    CREATE TABLE IF NOT EXISTS draw_records (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      resource_id TEXT NOT NULL,
      draw_date TEXT NOT NULL,
      week_key TEXT NOT NULL,
      FOREIGN KEY (resource_id) REFERENCES resources(id)
    )
  `);

  // 测评数据表
  db.run(`
    CREATE TABLE IF NOT EXISTS assessments (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      type TEXT NOT NULL CHECK(type IN ('cross', 'road')),
      row_index INTEGER NOT NULL,
      paixu TEXT,
      name TEXT,
      camera TEXT,
      direction TEXT,
      time_start TEXT,
      time_end TEXT,
      non_motor_count TEXT,
      reverse_count TEXT,
      red_light_count TEXT,
      stop_line_count TEXT,
      no_crosswalk_count TEXT,
      other_count TEXT,
      total TEXT,
      compliance_rate TEXT,
      right_turn_count TEXT,
      no_yield_count TEXT,
      yield_rate TEXT,
      illegal_count TEXT,
      evaluator TEXT NOT NULL,
      remark TEXT,
      non_motor_total TEXT,
      wrong_lane_count TEXT,
      compliance_rate_non TEXT,
      parking_violation TEXT,
      jaywalk_count TEXT,
      crosswalk_total TEXT,
      no_yield_cross TEXT,
      compliance_rate_cross TEXT,
      assessment_date TEXT NOT NULL,
      created_at TEXT DEFAULT (datetime('now')),
      updated_at TEXT DEFAULT (datetime('now'))
    )
  `);

  // ============================================================
  // 创建用户（2个超管 + 25个普通用户）
  // ============================================================
  const allUsers = [
    // 超级管理员
    { username: '石晓婷', password: '199639', role: 'admin' },
    { username: '白书语', password: 'Ywxtly0428', role: 'admin' },
    // 普通用户
